# ─── Supabase ───
NEXT_PUBLIC_SUPABASE_URL=https://xxxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...
SUPABASE_URL=${NEXT_PUBLIC_SUPABASE_URL}
SUPABASE_ANON_KEY=${NEXT_PUBLIC_SUPABASE_ANON_KEY}

# ─── API ───
NEXT_PUBLIC_API_URL=https://api.seudominio.com
PORT=3001

# ─── Redis (Redis Cloud — gerenciado, fora da VPS) ───
# Use a connection string do Redis Cloud. Com TLS ligado, use o esquema rediss://
# (dois "s") — o ioredis ativa TLS automaticamente. A senha vai embutida na URL.
# Necessária apenas em: api, whatsapp, workers.
REDIS_URL=rediss://default:SUA_SENHA@redis-xxxxx.c1.regiao.ec2.redns.redis-cloud.com:PORTA
# Sem TLS: redis://default:SUA_SENHA@host:porta
# Local (docker-compose dev): redis://localhost:6379

# ─── WhatsApp ───
WHATSAPP_PORT=3003
UAZAPI_WEBHOOK_TOKEN=
BOT_DEBOUNCE_MS=5000
META_VERIFY_TOKEN=
META_APP_SECRET=

# ─── OpenAI ───
OPENAI_API_KEY=

# ─── Workers ───
WORKERS_PORT=3005
CRON_SECRET=

# ─── Ads Engine ───
ADS_PORT=3006

# ─── Integrations ───
INTEGRATIONS_PORT=3004

# ─── Internal service communication ───
# OBRIGATÓRIO: gere uma string aleatória forte (ex: openssl rand -hex 32).
# Os serviços falham no boot / rejeitam chamadas internas se estiver vazio.
INTERNAL_API_SECRET=
WHATSAPP_INTERNAL_URL=http://lotta_lotta-whatsapp:3003
ADS_INTERNAL_URL=http://lotta_lotta-ads:3006

# ─── CORS allowlist ───
ADMIN_URL=https://app.seudominio.com
MENU_URL=https://cardapio.seudominio.com
